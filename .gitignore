# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local artifacts produced by smoke tests, screenshots, demo data
artifacts/
!artifacts/.gitkeep

# Never commit secrets or local credential files
.env
.env.*
!.env.example
*.local.json
secrets.*
cartridge_credentials.*

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Application data (databases live beside the games root, never in the repo)
*.db
*.db-journal
*.db-wal
*.db-shm

# Crash dumps (a Qt abort in the sandbox dropped a 47 MB 'core' file here once)
core
core.*
*.dmp
hs_err_pid*.log
